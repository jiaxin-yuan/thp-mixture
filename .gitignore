# ========================
# 1. macOS 系统自动生成文件
# ========================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# ========================
# 2. 安全与敏感信息 (最重要)
# ========================
.env
.env.*
*.pem
*.key
id_rsa
# 如果有包含数据库账号密码的配置文件，请在这里加上，例如：
# config/database.yml

# ========================
# 3. 日志与缓存文件
# ========================
*.log
*.gz
.cache/
__pycache__/

# ========================
# 4. 依赖包与编译输出 (视语言而定)
# ========================
node_modules/
venv/
.venv/
dist/
build/
*.class

# ========================
# 5. IDE 与编辑器配置文件
# ========================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj*.pyc
__pycache__/

# generated by runs
data/
saved_models/
runs/
logs_*.log
results/
results_*_v2/

# the shipped result artifacts are csv, and the parent .gitignore drops *.csv
!paper_results/*.csv
!paper_results/**/*.csv
